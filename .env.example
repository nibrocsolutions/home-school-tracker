# Copy to .env and adjust as needed
POSTGRES_USER=hst_user
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=home_school_tracker
SECRET_KEY=change_me_to_a_long_random_secret_key
APP_PORT=8080
# Optional: absolute path to lesson media library (defaults to ./media or /app/media)
# MEDIA_ROOT=/app/media

# Scheduled backup snapshots (see docs/backup-cron.md)
# BACKUP_DIR=/app/backups
# BACKUP_KEEP_COUNT=28
# Token for Mac/curl pulls via GET /api/backup/export
# BACKUP_EXPORT_TOKEN=long-random-secret
# Optional offsite upload from `python -m app.backup_snapshot`
# BACKUP_S3_URI=s3://your-bucket/home-school-tracker/
# BACKUP_UPLOAD_CMD=rclone copy '{path}' b2:homeschool-backups/
